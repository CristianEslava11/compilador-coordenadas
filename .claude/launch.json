{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "servidor:app", "--app-dir", "src", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--bind", "127.0.0.1", "--directory", "src/ui"],
      "port": 5500
    }
  ]
}
